// Milvus over a server the tests do not start: `MOONRAG_LIVE` says one is there.

import {
  "moonbitstack/moonrag",
  "moonbitstack/moonmilvus" @mstore,
  "moonbitstack/moonrag-integration/standard",
  "moonbitlang/async",
  "moonbitlang/core/env",
} for "test"

options(
  "supported_targets": "native",
  "max_concurrent_tests": 1,
)
