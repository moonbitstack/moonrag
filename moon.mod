name = "moonbitstack/moonrag"

version = "0.1.0"

readme = "README.md"

repository = "https://github.com/moonbitstack/moonrag"

license = "Apache-2.0"

keywords = [
  "rag",
  "retrieval",
  "retrieval-augmented-generation",
  "vector",
  "vector-store",
  "vector-search",
  "vector-database",
  "embeddings",
  "embedding-store",
  "similarity-search",
  "semantic-search",
  "cosine-similarity",
  "euclidean-distance",
  "mmr",
  "maximal-marginal-relevance",
  "retriever",
  "document",
  "document-loader",
  "document-splitting",
  "text-splitter",
  "chunking",
  "chunk",
  "recursive-splitter",
  "token-splitter",
  "html-splitter",
  "markdown",
  "csv",
  "json",
  "html",
  "indexing",
  "incremental-index",
  "knowledge-base",
  "context-window",
  "async",
  "moonbit",
]

description = "Documents, splitting, vector stores and retrieval for MoonBit. Embeddings come through a contract, so no model is needed."

source = "src"

import {
  "moonbitlang/async@0.22.5",
  "moonbitstack/moonxml@0.1.4",
  "moonbitstack/mooncrypt@0.4.11",
  "moonbitstack/moonbase@0.4.3",
}
